# Copy to .env and fill in your API key to enable AI features.
#
# Provider selection: set AI_PROVIDER=anthropic|gemini to force a specific
# provider. If unset, it's auto-detected: ANTHROPIC_API_KEY takes priority
# over GEMINI_API_KEY if both are set. If neither is set, the AI assistant
# reports itself as "not configured" (existing behavior, unchanged).
# AI_PROVIDER=anthropic

ANTHROPIC_API_KEY=your_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-6

# GEMINI_API_KEY=your_key_here
# GEMINI_MODEL=gemini-2.5-flash
